APP_ENV=development
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_READINESS_PATH=/models
LLM_REQUIRED_FOR_READINESS=false
READINESS_TIMEOUT_SECONDS=2
DATABASE_URL=mysql+pymysql://math_tutor:change-me@localhost:3306/math_tutor?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=math-tutor-agent
AUTH_JWT_AUDIENCE=math-tutor-web
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_REFRESH_COOKIE_NAME=math_tutor_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_EMAIL_VERIFICATION_MINUTES=1440
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_EXPOSE_DEVELOPMENT_TOKENS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_FAIL_CLOSED=true
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_LOGIN_ACCOUNT_ATTEMPTS=8
AUTH_RATE_LIMIT_LOGIN_COMBINED_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_REGISTER_IP_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTER_ACCOUNT_ATTEMPTS=3
AUTH_RATE_LIMIT_REGISTER_COMBINED_ATTEMPTS=2
AUTH_RATE_LIMIT_GUARDIAN_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_GUARDIAN_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_GUARDIAN_ACCOUNT_ATTEMPTS=10
AUTH_RATE_LIMIT_GUARDIAN_COMBINED_ATTEMPTS=6
REDIS_ENABLED=true
REDIS_COORDINATION_FAIL_CLOSED=true
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=math-tutor:v1
REDIS_SESSION_TTL_SECONDS=3600
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_LOCK_TTL_SECONDS=120
REDIS_LOCK_WAIT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_MAX_CONNECTIONS=20
HARNESS_MAX_AGENT_CALLS=8
HARNESS_MAX_DURATION_MS=60000
SOLUTION_MAX_REVISION_ATTEMPTS=2
KNOWLEDGE_PROBLEM_MAX_REVISION_ATTEMPTS=2
RAG_ENABLED=false
RAG_PROVIDER=
RAG_TOP_K=5
RAG_TIMEOUT_SECONDS=3
RAG_MAX_CONTEXT_CHARS=12000
RAG_REQUIRED_FOR_READINESS=false
RAG_HYBRID_RRF_K=60
RAG_HYBRID_VECTOR_WEIGHT=1.0
RAG_HYBRID_KEYWORD_WEIGHT=1.0
RAG_RERANK_FUSION_WEIGHT=0.55
RAG_RERANK_CONDITION_WEIGHT=0.20
RAG_RERANK_TARGET_WEIGHT=0.15
RAG_RERANK_SOLUTION_WEIGHT=0.10
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=900
RAG_CACHE_NO_RESULTS_TTL_SECONDS=60
RAG_CACHE_SCHEMA_VERSION=v1
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=math_tutor_knowledge_v1
QDRANT_VECTOR_NAME=dense
QDRANT_SCORE_THRESHOLD=0.25
QDRANT_OVERSAMPLING_FACTOR=4
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_READINESS_PATH=/models
PRODUCTION_INDEX_VERSION=v1
PRODUCTION_INDEX_SYNC_LIMIT=100
PRODUCTION_EMBEDDING_BATCH_SIZE=32
PRODUCTION_INDEX_TIMEOUT_SECONDS=30
PRODUCTION_INDEX_MAINTENANCE_MAX_ATTEMPTS=5
PRODUCTION_INDEX_MAINTENANCE_LEASE_SECONDS=300
QUALITY_MAX_ERRONEOUS_ADMISSION_RATE=0
QUALITY_RELEASE_MIN_AUTO_ADMISSIONS=1
