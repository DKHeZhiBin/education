  "cards": [
    {
      "dot": "cyan",
      "title": "在线辅导主链",
      "items": [
        "学生端只面对统一辅导体验；Harness 控制预算、幂等、锁、追踪与持久化。",
        "教学 Orchestrator 组织专职 Agent，并按题意、解法和提示阶段决定是否调用 RAG。"
      ]
    },
    {
      "dot": "emerald",
      "title": "题库接入规则",
      "items": [
        "候选题先经过验证证据与规则化准入；确定性失败不能被模型意见覆盖。",
        "只有 approved 内容可由生产索引服务写入关键词索引和 Qdrant，随后成为 indexed。"
      ]
    },
    {
      "dot": "violet",
      "title": "共享基础设施",
      "items": [
        "MySQL 保存会话、题库状态、准入证据和关键词投影；Redis 保存短期缓存并处理运行时协调。",
        "Qdrant 只承载可生产检索的向量内容；Embedding 与 LLM 均通过可替换 Provider 接入。"
      ]
    }
  ]
}
